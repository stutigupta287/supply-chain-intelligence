# Environment Variables for Docker Compose
# Copy this file to .env and update values as needed

# PostgreSQL Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=supply_chain

# Application Configuration  
SPRING_PROFILES_ACTIVE=default
JAVA_OPTS=-Xmx512m -Xms256m

# CSV Data Loader Configuration
# Set to 'true' to load CSV data on startup, 'false' to skip
LOAD_CSV_ON_STARTUP=true
# Path to curated CSV file (relative to container working directory)
CSV_PATH=curated/shipments_curated.csv
# Skip loading if database already has data (prevents duplicates)
SKIP_IF_DATA_EXISTS=true

# Ports (change if you have conflicts)
# POSTGRES_PORT=5432
# API_PORT=8080
